# Local dev: direct connection is fine.
# Vercel: use the Supabase *pooler* URL (Dashboard > Connect > Transaction pooler, IPv4),
# e.g. postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# The direct host (db.<ref>.supabase.co) is IPv6-only and Vercel builds fail with ENETUNREACH.
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only, dipakai CMS untuk upload ke Storage
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=projek
JWT_SECRET=<random 64 hex>
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=<initial admin password>
